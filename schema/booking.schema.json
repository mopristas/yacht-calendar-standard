{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mopristas/yacht-calendar-standard/schema/booking.schema.json",
  "title": "Booking or hold (Level 3: calendar:read)",
  "type": "object",
  "required": ["id", "yacht_id", "status", "start", "end", "timezone", "pickup", "dropoff", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "yacht_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "start": { "$ref": "common.schema.json#/$defs/local_datetime" },
    "end": { "$ref": "common.schema.json#/$defs/local_datetime" },
    "timezone": { "$ref": "common.schema.json#/$defs/timezone" },
    "pickup": { "$ref": "common.schema.json#/$defs/location" },
    "dropoff": { "$ref": "common.schema.json#/$defs/location" },
    "hold_expires": { "$ref": "common.schema.json#/$defs/utc_timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/utc_timestamp" }
  },
  "if": { "properties": { "status": { "const": "hold" } } },
  "then": { "required": ["hold_expires"] }
}
